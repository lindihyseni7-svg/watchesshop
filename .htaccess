# Send clean URLs to the PHP front controller while preserving real files/assets.
Options -Indexes
RewriteEngine On

# Legacy public URLs. Relative redirects work both in /watchesshop locally and
# at the domain root on shared hosting.
RewriteRule ^orat\.php$ shop [R=302,L,QSD]
RewriteRule ^shporta\.php$ cart [R=302,L,QSD]
RewriteRule ^login\.php$ login [R=302,L,QSD]
RewriteRule ^regjistrohu\.php$ register [R=302,L,QSD]
RewriteRule ^shto_ne_shporte\.php$ cart [R=302,L,QSD]
RewriteRule ^edito_shporte\.php$ cart [R=302,L,QSD]
RewriteRule ^fshi_nga_shporta\.php$ cart [R=302,L,QSD]

# Legacy admin lists.
RewriteRule ^perdoruesit\.php$ admin/users [R=302,L,QSD]
RewriteRule ^kategorite\.php$ admin/categories [R=302,L,QSD]
RewriteRule ^brendet\.php$ admin/brands [R=302,L,QSD]
RewriteRule ^ofertat\.php$ admin/offers [R=302,L,QSD]

# Legacy create/edit forms preserve their old record identifiers.
RewriteCond %{QUERY_STRING} (?:^|&)pid=([0-9]+)(?:&|$)
RewriteRule ^shto_modifiko_perdorues\.php$ admin/users/%1/edit [R=302,L,QSD]
RewriteRule ^shto_modifiko_perdorues\.php$ admin/users/create [R=302,L,QSD]
RewriteCond %{QUERY_STRING} (?:^|&)kid=([0-9]+)(?:&|$)
RewriteRule ^shto_modifiko_kategori\.php$ admin/categories/%1/edit [R=302,L,QSD]
RewriteRule ^shto_modifiko_kategori\.php$ admin/categories/create [R=302,L,QSD]
RewriteCond %{QUERY_STRING} (?:^|&)brendetid=([0-9]+)(?:&|$)
RewriteRule ^shto_modifiko_brend\.php$ admin/brands/%1/edit [R=302,L,QSD]
RewriteRule ^shto_modifiko_brend\.php$ admin/brands/create [R=302,L,QSD]
RewriteCond %{QUERY_STRING} (?:^|&)ofertaid=([0-9]+)(?:&|$)
RewriteRule ^shto_modifiko_ofert\.php$ admin/offers/%1/edit [R=302,L,QSD]
RewriteRule ^shto_modifiko_ofert\.php$ admin/offers/create [R=302,L,QSD]

# Legacy delete pages now point to POST-only CRUD lists.
RewriteRule ^fshijperdorues\.php$ admin/users [R=302,L,QSD]
RewriteRule ^fshijkategori\.php$ admin/categories [R=302,L,QSD]
RewriteRule ^fshijbrend\.php$ admin/brands [R=302,L,QSD]
RewriteRule ^fshijofert\.php$ admin/offers [R=302,L,QSD]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [QSA,L]
